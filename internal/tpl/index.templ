package tpl

import (
	"github.com/nsf/go-pwa-template/internal/tea"
	"github.com/starfederation/datastar-go/datastar"
)

templ head(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/style.css"/>
		<script type="module" src="/static/datastar.js"></script>
		<link rel="manifest" href="/static/manifest.json"/>
		<meta name="theme-color" content="#202020"/>
	</head>
}

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title)
		<body>
			<div class="h-dvh standalone:h-svh fullscreen:h-svh flex justify-center">
				<div class="w-full max-w-xl">
					{ children... }
				</div>
			</div>
		</body>
	</html>
}

//--------------------------------------------------------------------------------------
templ IndexContent(model tea.Model) {
	{{ sess := tea.SessionFromContextMust(ctx) }}
	<div id="index-page" data-init="@get('/updates')" class="p-2 flex flex-col gap-2 h-full">
		<div class="flex justify-center">
			Open this page in multiple windows
		</div>
		<div class="flex gap-2 justify-center">
			<button type="button" class="btn btn-primary" data-on:click={ datastar.PostSSE("/button") }>
				Shared Button { model.NumPresses }
			</button>
			<button type="button" class="btn btn-primary" data-on:click={ datastar.PostSSE("/session/button") }>
				Session Button { sess.NumPresses }
			</button>
		</div>
	</div>
}

templ Index(model tea.Model) {
	@layout("My Application") {
		@IndexContent(model)
	}
}
